{
	admin off
	auto_https disable_redirects
	skip_install_trust
	default_sni {$KNOWLEDGE_DEFAULT_SNI}
}

{$KNOWLEDGE_SITES} {
	tls internal
	route {
		@unauthorized not header Authorization "Bearer {$KNOWLEDGE_TOKEN}"
		respond @unauthorized "Unauthorized" 401
		@memory path /mcp /mcp/*
		handle @memory {
			reverse_proxy 127.0.0.1:8000 {
				header_up Host localhost:8000
				header_up -Authorization
				flush_interval -1
			}
		}
		respond "Not found" 404
	}
}

http://:8081 {
	respond /healthz "ok" 200
}
